def run_abstract(seed: int = 42) -> Tuple[PRMREngine, List[EpochState]]:
    """
    Abstract domain: dimensionless, paper-exact baseline parameters.
    This is the canonical PRMR run.
    """
    np.random.seed(seed)
    H = GenealogyTree()

    initial = EpochState(
        tau=0,
        V=[Vortex(id=0, a=250.0, omega=2.5, I=1500.0,
                  x=np.zeros(2), v=np.zeros(2), g=0)],
        H=H
    )

    engine = PRMREngine(domain=Domain.ABSTRACT, eternal_return=False)
    history = engine.run(initial, n_cycles=200)
    return engine, history


