# SECTION 5: ANALYSIS AND OUTPUT
# =============================================================================

def analyse(engine: PRMREngine,
            history: List[EpochState],
            label: str = "PRMR") -> Dict:
    """
    Compute validation metrics and return structured results.
    """
    fitnesses = [s.Phi for s in history]
    infos = [s.I_total for s in history]

    # Fitness monotonicity (strict)
    strict_mono = all(fitnesses[i] <= fitnesses[i+1]
                      for i in range(len(fitnesses)-1))

    # Fitness trend over long window (10-cycle rolling)
    window = 10
    trend_up = 0
    trend_total = max(1, len(fitnesses) - window)
    for i in range(trend_total):
        if fitnesses[min(i+window, len(fitnesses)-1)] > fitnesses[i]:
            trend_up += 1
    long_trend_fraction = trend_up / trend_total

    final = history[-1]
    initial = history[0]

    info_growth = (final.I_total / max(initial.I_total, 1e-9))
    terminated_naturally = (final.tau >= engine.N_max and not engine.eternal_return)

    results = {
        'domain': engine.domain.value,
        'N_max': engine.N_max,
        'cycles_run': len(history) - 1,
        'terminated_naturally': terminated_naturally,
        'eternal_return_enabled': engine.eternal_return,
        'rebirth_count': engine.rebirth_count,
        'final_vortices': len(final.V),
        'info_growth_factor': float(info_growth),
        'fitness_strict_monotone': strict_mono,
        'fitness_long_trend_fraction': float(long_trend_fraction),
        'peak_fitness': float(max(fitnesses)),
        'final_fitness': float(fitnesses[-1]),
        'genealogy': final.H.summary(),
        'max_generation': max((v.g for s in history for v in s.V), default=0),
        'trajectory': [s.to_dict() for s in history],
    }
    return results


