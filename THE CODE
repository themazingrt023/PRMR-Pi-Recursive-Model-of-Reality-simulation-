@dataclass
class Vortex:
    """
    Primitive structural unit of PRMR (Section 3.1).

    Properties (paper symbols):
      a     — spatial scale
      omega — vorticity (structural coherence)
      I     — information content
      x     — position vector
      v     — velocity vector
      m     — effective mass (emergent from I and omega)
      g     — generation index (recursion depth)
    """
    id: int
    a: float            # spatial scale
    omega: float        # vorticity
    I: float            # information content
    x: np.ndarray       # position
    v: np.ndarray       # velocity
    m: float = 0.0      # emergent mass
    g: int = 0          # generation index
    parent_id: int = -1 # for building H

    def __post_init__(self):
        self.x = np.array(self.x, dtype=float)
        self.v = np.array(self.v, dtype=float)


@dataclass
class MergerRecord:
    """One entry in the genealogy tree H."""
    cycle: int
    parent_ids: Tuple[int, int]
    child_id: int
    info_retained: float
    generation: int


class GenealogyTree:
    """
    H: hierarchical merger genealogy (Section 3.1).
    Tracks the full lineage of every vortex across all cycles.
    """
    def __init__(self):
        self.records: List[MergerRecord] = []
        self.lineage: Dict[int, List[int]] = {}  # id -> ancestor ids

    def record_merger(self, cycle: int, v1: Vortex, v2: Vortex,
                      child: Vortex, info_retained: float):
        rec = MergerRecord(
            cycle=cycle,
            parent_ids=(v1.id, v2.id),
            child_id=child.id,
            info_retained=info_retained,
            generation=child.g
        )
        self.records.append(rec)

        # Build lineage
        ancestors = set()
        for pid in [v1.id, v2.id]:
            ancestors.add(pid)
            ancestors.update(self.lineage.get(pid, []))
        self.lineage[child.id] = list(ancestors)

    def depth(self, vortex_id: int) -> int:
        """Recursion depth of a vortex: how many merger generations deep."""
        return len(self.lineage.get(vortex_id, []))

    def summary(self) -> Dict:
        return {
            'total_mergers': len(self.records),
            'max_depth': max((self.depth(r.child_id) for r in self.records), default=0),
            'lineage_entries': len(self.lineage)
        }

    def to_list(self) -> List[Dict]:
        return [
            {
                'cycle': r.cycle,
                'parents': list(r.parent_ids),
                'child': r.child_id,
                'info_retained': r.info_retained,
                'generation': r.generation
            }
            for r in self.records
        ]


@dataclass
class EpochState:
    """
    S_n = (V_n, d_n, I_n, H_n, Phi_n, tau_n)
    Formal epoch state per Definition 1 (Section 3.1).
    """
    tau: int                         # epoch parameter (monotonically increasing)
    V: List[Vortex]                  # vortex set
    H: GenealogyTree                 # genealogy tree (shared reference across epochs)
    Phi: float = 0.0                 # fitness
    I_total: float = 0.0             # total information
    I_active: float = 0.0            # info in active vortices
    hierarchy_ratio: float = 1.0     # scale hierarchy
    correlation_length: float = 0.0  # spatial coherence
    n_mergers: int = 0
    n_fragmentations: int = 0
    n_dissipated: int = 0

    def to_dict(self) -> Dict:
        return {
            'tau': self.tau,
            'n_vortices': len(self.V),
            'I_total': float(self.I_total),
            'I_active': float(self.I_active),
            'Phi': float(self.Phi),
            'hierarchy_ratio': float(self.hierarchy_ratio),
            'correlation_length': float(self.correlation_length),
            'n_mergers': self.n_mergers,
            'n_fragmentations': self.n_fragmentations,
            'n_dissipated': self.n_dissipated,
            'genealogy': self.H.summary()
        }


