class PRMREngine:
    """
    Core recursive engine implementing the three operators F, G, R
    per Section 3.2, with parameters from Table 1.

    Parameters (paper symbols → Table 1 baseline):
      alpha       = 0.50   mass-information coupling
      eta         = 0.10   per-cycle info loss (fragmentation)
      beta        = 3.0    vorticity-driven fragmentation factor
      a_crit      = 100.0  scale threshold triggering fragmentation
      omega_crit  = 0.20   vorticity threshold for survival
      rho         = 0.85   info retention during merger
      G_eff       = 1.0    gravitational coupling (dimensionless)
      gamma       = 0.02   velocity damping
      d_merge     = 8.0    spatial proximity for merger
      delta       = 0.25   scale growth for surviving vortices
      mu          = 0.50   info gain rate during nucleation

    Optional extended mode:
      eternal_return  — if True, background entropy seeds new vortex
                        after termination (not in paper, flagged explicitly)
    """

    # --- Table 1 baseline (paper-exact) ---
    DEFAULT_PARAMS = dict(
        alpha=0.50,
        eta=0.10,
        beta=3.0,
        a_crit=100.0,
        omega_crit=0.20,
        rho=0.85,
        G_eff=1.0,
        gamma=0.02,
        d_merge=8.0,
        delta=0.25,
        mu=0.50,
    )

    def __init__(self,
                 domain: Domain = Domain.ABSTRACT,
                 eternal_return: bool = False,
                 eternal_seed_fraction: float = 0.20,
                 eternal_min_info: float = 100.0,
                 n_gravity_steps: int = 50,
                 dt: float = 0.1,
                 f_esc: float = 1.5,
                 **param_overrides):

        self.domain = domain
        self.eternal_return = eternal_return
        self.eternal_seed_fraction = eternal_seed_fraction
        self.eternal_min_info = eternal_min_info
        self.n_steps = n_gravity_steps
        self.dt = dt
        self.f_esc = f_esc

        # Apply params (Table 1 defaults, then any overrides)
        p = dict(self.DEFAULT_PARAMS)
        p.update(param_overrides)
        for k, v in p.items():
            setattr(self, k, v)

        # State
        self.vortex_counter = 0
        self.history: List[EpochState] = []
        self.background_info: float = 0.0  # only used if eternal_return=True
        self.rebirth_count: int = 0

        # Recursion bound (Section 3.4)
        # N_max = ln(I_0 / theta) / ln(1 / (1 - eta))
        # Computed at first run() call once I_0 is known
        self.N_max: Optional[int] = None
        self.dissipation_threshold_fraction = 0.01  # theta = 1% of I_0

    def compute_recursion_bound(self, I_0: float) -> int:
        """
        Section 3.4: maximum cycles before info falls below threshold.
        N_max = ln(I_0 / theta) / ln(1 / (1 - eta))
        """
        theta = I_0 * self.dissipation_threshold_fraction
        if theta <= 0 or self.eta >= 1.0:
            return 999
        N_max = np.log(I_0 / theta) / np.log(1.0 / (1.0 - self.eta))
        return max(1, int(np.ceil(N_max)))

    # -------------------------------------------------------------------------
    # Emergent mass (Section 3.1)
    # -------------------------------------------------------------------------
    def emergent_mass(self, v: Vortex) -> float:
        """m = I * (1 + alpha * omega)"""
        v.m = v.I * (1.0 + self.alpha * v.omega)
        return v.m

    # -------------------------------------------------------------------------
    # Fitness function Phi (Definition 2)
    # -------------------------------------------------------------------------
    def compute_fitness(self, state: EpochState) -> float:
        """
        Phi = I_total * hierarchy_ratio * ln(1 + correlation_length)
        Definition 2, Section 3.3.
        """
        for v in state.V:
            self.emergent_mass(v)

        state.I_active = sum(v.I for v in state.V)
        state.I_total = state.I_active + (self.background_info if self.eternal_return else 0.0)

        if not state.V:
            state.Phi = 0.0
            return 0.0

        scales = [v.a for v in state.V]
        state.hierarchy_ratio = max(scales) / (np.mean(scales) + 1e-9)

        masses = np.array([v.m for v in state.V])
        positions = np.array([v.x for v in state.V])
        total_mass = np.sum(masses)

        if total_mass > 0:
            centroid = np.average(positions, axis=0, weights=masses)
            dists = np.linalg.norm(positions - centroid, axis=1)
            state.correlation_length = float(np.average(dists, weights=masses))
        else:
            state.correlation_length = 0.0

        state.Phi = (state.I_total *
                     state.hierarchy_ratio *
                     np.log1p(state.correlation_length))
        return state.Phi

    # -------------------------------------------------------------------------
    # Operator F: Fragmentation
    # -------------------------------------------------------------------------
    def fragmentation(self, state: EpochState) -> EpochState:
        """
        F: vortices with a > a_crit split into k daughters.
        k = clip(omega * beta, 2, k_max).
        Generation index g increments in daughters (not in paper explicitly,
        but consistent with g tracking recursion depth).
        Info distributed with fractional loss eta.
        """
        new_V = []
        n_frag = 0
        info_lost = 0.0

        for v in state.V:
            if v.a > self.a_crit:
                n_frag += 1
                # k scales with omega AND generation — higher-gen vortices
                # are more structured, fragment less aggressively
                gen_damping = 1.0 / (1.0 + 0.1 * v.g)
                k = max(2, min(int(v.omega * self.beta * gen_damping), 8))

                info_children = v.I * (1.0 - self.eta)
                info_per = info_children / k
                lost = v.I * self.eta
                info_lost += lost

                if self.eternal_return:
                    self.background_info += lost

                vorticity_child = v.omega * np.random.uniform(0.8, 1.2)
                angles = np.linspace(0, 2 * np.pi, k, endpoint=False)
                radius = v.a * 0.05

                for angle in angles:
                    offset = radius * np.array([np.cos(angle), np.sin(angle)])
                    child = Vortex(
                        id=self.vortex_counter,
                        a=(v.a / k) * np.random.uniform(0.85, 1.15),
                        omega=vorticity_child,
                        I=info_per,
                        x=v.x + offset,
                        v=np.zeros(2),
                        g=v.g + 1,       # generation increments
                        parent_id=v.id
                    )
                    self.vortex_counter += 1
                    new_V.append(child)
            else:
                new_V.append(v)

        next_state = EpochState(
            tau=state.tau,
            V=new_V,
            H=state.H,
            n_fragmentations=n_frag
        )
        return next_state

    # -------------------------------------------------------------------------
    # Operator G: Gravitational evolution
    # -------------------------------------------------------------------------
    def gravitational_evolution(self, state: EpochState) -> EpochState:
        """
        G: vectorised Newtonian-like gravity with velocity damping gamma.
        Uses vectorised pairwise forces (O(n^2) but fast with numpy).
        Force: F_ij = G_eff * m_i * m_j / (r_ij^2 + softening^2)
        Damping: v *= (1 - gamma) per step.
        """
        vortices = state.V
        if len(vortices) <= 1:
            return state

        for v in vortices:
            self.emergent_mass(v)

        pos = np.array([v.x for v in vortices])   # (n, 2)
        vel = np.array([v.v for v in vortices])   # (n, 2)
        masses = np.array([v.m for v in vortices]) # (n,)
        softening = 0.5

        for _ in range(self.n_steps):
            # Vectorised pairwise differences: (n, n, 2)
            diff = pos[:, None, :] - pos[None, :, :]          # r_i - r_j
            r2 = np.sum(diff**2, axis=2) + softening**2       # (n, n)
            r2[np.arange(len(vortices)), np.arange(len(vortices))] = np.inf
            # Force magnitudes: F_ij = G * mi * mj / r^2, direction toward j
            F_mag = self.G_eff * masses[None, :] / r2         # (n, n)
            forces = -np.sum(F_mag[:, :, None] * diff, axis=1) # (n, 2)
            acc = forces * masses[:, None] / (masses[:, None]**2 + 1e-9)
            vel = vel * (1.0 - self.gamma) + acc * self.dt
            pos = pos + vel * self.dt

        for i, v in enumerate(vortices):
            v.x = pos[i]
            v.v = vel[i]

        state.V = vortices
        return state

    # -------------------------------------------------------------------------
    # Operator R: Nucleation and Merger
    # -------------------------------------------------------------------------
    def nucleation_and_merger(self, state: EpochState) -> EpochState:
        """
        R: two phases per Section 3.2.

        Phase 1 — Nucleation:
          vortices with omega < omega_crit are dissipated.
          survivors gain scale (delta) and info (mu).

        Phase 2 — Merger:
          pairs within d_merge with rel_v < f_esc * v_escape merge.
          merged vortex: mass-weighted position/velocity,
          info = I1 + rho * I2, g = max(g1, g2) + 1.
          merger recorded in H.
        """
        # --- Nucleation ---
        survivors = []
        n_dissipated = 0

        for v in state.V:
            if v.omega >= self.omega_crit:
                v.a *= (1.0 + self.delta)
                v.I += self.mu * v.omega * v.I
                v.omega *= 0.95
                survivors.append(v)
            else:
                if self.eternal_return:
                    self.background_info += v.I
                n_dissipated += 1

        # Eternal return: seed from background if enabled and all dead
        if self.eternal_return and len(survivors) == 0:
            if self.background_info >= self.eternal_min_info:
                seed_I = self.eternal_seed_fraction * self.background_info
                self.background_info -= seed_I
                seed = Vortex(
                    id=self.vortex_counter,
                    a=self.a_crit * 0.6,
                    omega=self.omega_crit * 1.5,
                    I=seed_I,
                    x=np.zeros(2),
                    v=np.zeros(2),
                    g=0,
                    parent_id=-2
                )
                self.vortex_counter += 1
                survivors = [seed]
                self.rebirth_count += 1

        # --- Merger ---
        survivors.sort(key=lambda v: v.m, reverse=True)
        merged = []
        used: Set[int] = set()
        n_mergers = 0

        for i, v1 in enumerate(survivors):
            if i in used:
                continue
            merged_this = False
            for j, v2 in enumerate(survivors[i+1:], start=i+1):
                if j in used:
                    continue
                dist = np.linalg.norm(v1.x - v2.x)
                if dist < self.d_merge:
                    rel_v = np.linalg.norm(v1.v - v2.v)
                    v_esc = np.sqrt(2.0 * self.G_eff * v1.m / (dist + 0.1))
                    if rel_v < self.f_esc * v_esc:
                        m_total = v1.m + v2.m
                        child = Vortex(
                            id=self.vortex_counter,
                            a=v1.a + v2.a,
                            omega=((v1.omega * v1.m + v2.omega * v2.m) / m_total),
                            I=v1.I + self.rho * v2.I,
                            x=((v1.x * v1.m + v2.x * v2.m) / m_total),
                            v=((v1.v * v1.m + v2.v * v2.m) / m_total),
                            m=m_total,
                            g=max(v1.g, v2.g) + 1,
                            parent_id=-1
                        )
                        self.vortex_counter += 1
                        state.H.record_merger(
                            state.tau, v1, v2, child,
                            info_retained=child.I
                        )
                        merged.append(child)
                        used.add(i)
                        used.add(j)
                        n_mergers += 1
                        merged_this = True
                        break
            if not merged_this:
                merged.append(v1)

        next_state = EpochState(
            tau=state.tau + 1,
            V=merged,
            H=state.H,
            n_mergers=n_mergers,
            n_dissipated=n_dissipated,
            n_fragmentations=state.n_fragmentations
        )
        self.compute_fitness(next_state)
        return next_state

    # -------------------------------------------------------------------------
    # Single PRMR cycle: S_n -> S_{n+1}
    # -------------------------------------------------------------------------
    def step(self, state: EpochState) -> EpochState:
        """One recursive cycle: F then G then R."""
        s1 = self.fragmentation(state)
        s2 = self.gravitational_evolution(s1)
        s3 = self.nucleation_and_merger(s2)
        return s3

    # -------------------------------------------------------------------------
    # Run
    # -------------------------------------------------------------------------
    def run(self, initial_state: EpochState,
            n_cycles: int = 100) -> List[EpochState]:
        """
        Run PRMR for up to n_cycles, respecting the recursion bound N_max.
        Terminates early if:
          (a) tau >= N_max (recursion bound reached), or
          (b) all vortices dead and eternal_return=False (natural dissipation)
        """
        # Compute recursion bound from initial information
        I_0 = sum(v.I for v in initial_state.V)
        self.N_max = self.compute_recursion_bound(I_0)

        self.compute_fitness(initial_state)
        self.history = [initial_state]
        current = initial_state

        effective_max = min(n_cycles, self.N_max)

        for i in range(effective_max):
            current = self.step(current)
            self.history.append(current)

            all_dead = (len(current.V) == 0 and
                        (not self.eternal_return or
                         self.background_info < self.eternal_min_info))
            if all_dead:
                break

        return self.history


